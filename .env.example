# SF授权系统 环境配置
# 线上部署时请复制此文件为 .env 并根据实际环境修改

# 应用调试模式（线上必须为 false）
app_debug = false

# 数据库配置
database.hostname = localhost
database.database = www_admindev_com
database.username = your_db_user
database.password = your_db_password
database.hostport = 3306

# 系统配置
system.sitename = SF授权平台
system.nickname = SF
system.version = 4.2.9

# 域名配置（填写实际的完整URL，不带末尾斜杠）
domain.img_url = https://your-domain.com

# 日志通道
log.channel = file
