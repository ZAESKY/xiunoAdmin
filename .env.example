# SF授权系统 环境配置
# 线上部署时请复制此文件为 .env 并根据实际环境修改

# 应用调试模式（线上必须为 false）
app_debug = false

# 数据库配置
database_hostname = localhost
database_database = www_admindev_com
database_username = your_db_user
database_password = your_db_password
database_hostport = 3306

# 系统配置
system_sitename = SF授权平台
system_nickname = SF
system_version = 4.2.9

# 域名配置（填写实际的完整URL，不带末尾斜杠）
domain_img_url = https://your-domain.com

# 阿里云 OSS 配置（oss_enabled=false 时强制使用本地存储）
oss_enabled = false
oss_access_key_id =
oss_access_key_secret =
oss_bucket =
oss_endpoint =
oss_region =
oss_public_base_url =
oss_use_private_bucket = false

# 日志通道
log_channel = file
