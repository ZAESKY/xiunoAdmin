# QH授权系统 环境配置
# 线上部署时请复制此文件为 .env 并根据实际环境修改

# 应用调试模式（线上必须为 false）
app_debug = false

# 数据库配置
database_hostname = localhost
database_database = www_admindev_com
database_username = your_db_user
database_password = your_db_password
database_hostport = 3306
database_charset = utf8mb4

# 系统配置
system_sitename = QH授权平台
system_nickname = QH
system_version = 4.2.9

# 域名配置（填写实际的完整URL，不带末尾斜杠）
app_host = https://your-domain.com
domain_img_url = https://your-domain.com

# QQ互联 OAuth（生产密钥只放 .env，不要提交到代码仓库）
qq_oauth_appid =
qq_oauth_appkey =
qq_oauth_callback_base = https://www.example.com
# QQ互联后台切换完成前留空；切换后填写 api.php/Social/callback
qq_oauth_callback_path =
qq_oauth_default_appid = 1

# 新旧站点隔离（每个站点必须使用不同值）
cookie_domain =
cookie_secure = true
cookie_httponly = true
cookie_samesite = Lax

# Optional comma-separated exact browser origins allowed to call /api.php cross-origin.
# app_cors_origins = https://admin.example.com,https://user.example.com

# 邮件发送（授权码只保存在服务器 .env，不要写入源码）
mail_smtp_server = smtp.example.com
mail_smtp_port = 465
mail_smtp_username =
mail_smtp_authcode =
mail_test_recipient =
session_name = QHADMINSESSID
session_prefix = qh_admin_session:
cache_driver = file
cache_path =
cache_prefix = qh_admin_cache:
queue_default = sync
queue_name = qh_admin_queue
redis_host = 127.0.0.1
redis_port = 6379
redis_password =
redis_cache_database = 1
redis_queue_database = 2

# 阿里云 OSS 配置（oss_enabled=false 时强制使用本地存储）
oss_enabled = false
oss_access_key_id =
oss_access_key_secret =
oss_bucket =
oss_endpoint =
oss_region =
oss_public_base_url =
# 必须使用私有 Bucket；新上传对象还会额外设置 object ACL=private
oss_use_private_bucket = true

# 本地插件包持久化目录（生产环境应放在 releases 之外，并仅授予 PHP 用户写权限）
plugin_storage_path =

# 日志通道
log_channel = file

# ==================== 授权体系 v2（P1–P3）====================
# 全部密钥用 php think qh:keygen 生成，切勿提交到 Git

# 服务端 pepper：用于授权码哈希、IP 哈希等不可逆变换
# 生成：php -r "echo bin2hex(random_bytes(32));"
# ⚠ 一旦设置就不要更改，改动会使已回填的 authcode_hash 全部失效
security_pepper =

# 后台敏感配置（如短信AccessKey Secret）的数据库加密密钥。
# 生成：php -r "echo bin2hex(random_bytes(32));"
# 一旦保存过加密配置就不要随意更换；未配置时会依次使用 security_pepper 等现有服务端密钥。
config_secret_key =

# 授权响应签名密钥（Ed25519）—— php think qh:keygen license
license_sign_key_id     =
license_sign_secret_key =
license_sign_public_key =

# 发布物签名密钥（Ed25519）—— php think qh:keygen release
# ⚠ 私钥建议只放在离线签名机上，不要放在授权服务器
release_sign_key_id     =
release_sign_secret_key =
release_sign_public_key =

# 多公钥并存（密钥轮换过渡期用），格式：keyid1:base64,keyid2:base64
license_sign_public_keys =
release_sign_public_keys =

# license_secret 落库加密密钥（可选但强烈建议）
# 不配置时服务端只存 SHA-256，数据库泄露可被用于伪造请求签名
# 生成：php -r "echo bin2hex(random_bytes(32));"
license_secret_key =

# 授权失效策略：grace=默认宽限，immediate=立即停用受保护功能
license_failure_mode = grace
# grace 模式宽限秒数，默认 24 小时；服务端统一下发，客户端不可自行放宽
license_grace_seconds = 86400
# 在线域名归属证明默认只走 HTTPS；开启会允许降级到明文 HTTP（不推荐）
license_domain_verify_allow_http = false
# v2 产品标识与旧授权应用 ID 的明确映射；多个产品用逗号分隔。
# 旧 QH_auth 授权首次激活时只允许迁移到这里声明的产品，禁止跨产品套用授权码。
license_product_app_map = zaesky_theme_light:1
